# ==============================================================================
# Bagan Medical Hall Pharmacy POS & Accounting ERP
# Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=production

# Server Port (Passenger auto-assigns in cPanel; defaults to 3000 locally)
PORT=3000

# PostgreSQL Database Configuration (Isolated Staging Database)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=devkumar_baganstaging
DB_USER=devkumar_adminbaganstaging
DB_PASSWORD=replace_with_strong_random_db_password
DB_SSL=false

# Session Security (MANDATORY in production; minimum 32 cryptographic random characters)
# Note: The system utilizes Synchronizer Token Pattern (STP) using per-session SHA-256 tokens.
# SESSION_SECRET is the primary signing secret for signed session cookies (s:token.hmac).
SESSION_SECRET=replace_with_at_least_32_char_crypto_random_session_secret

# Production CORS Origin (MANDATORY in production; NO wildcards '*', NO trailing slashes)
# Configured for isolated staging domain. Multiple origins may be separated by commas.
CORS_ORIGIN=https://joyful-brown-jellyfish.devkumarrajbanshi.com.np

# Reverse Proxy Trust Level (Recommended: 'loopback' or '1' for cPanel Phusion Passenger)
TRUST_PROXY=loopback

# Media Storage Configuration (MANDATORY in production; MUST be an absolute path)
# Configured for staging frontend document root website_images directory.
MEDIA_UPLOAD_DIR=/home/devkumar/joyful-brown-jellyfish.103-233-58-13.cpanel.site/website_images
MEDIA_PUBLIC_URL_PREFIX=/website_images
